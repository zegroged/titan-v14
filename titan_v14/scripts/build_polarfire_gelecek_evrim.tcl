################################################################################
## PROJECT TITAN V13: PolarFire Libero Build Script
## Automation Script for Microchip Libero SoC
################################################################################
## AMA\u00c7: Vivado build_artix7.tcl benzeri otomasyon, ama Libero için.
##\n## KOMUTAN \u015eERH\u0130: \"Artix'in scripti var. PolarFire'\u0131n da olsun. E\u015fitlik!\"\n################################################################################\n\nset project_name \"titan_v13_polarfire\"\nset project_dir \"libero_polarfire\"\n\nputs \"=========================================\"\nputs \"  TITAN V13 - PolarFire Build\"\nputs \"=========================================\"\n\n################################################################################\n## PROJE OLUŞTUR\n################################################################################\n\n# Proje var m\u0131 kontrol et, varsa sil\nif {[file exists $project_dir]} {\n    puts \"UYARI: Mevcut proje siliniyor...\"\n    file delete -force $project_dir\n}\n\n# Yeni proje oluştur\nnew_project \\\n    -name $project_name \\\n    -location $project_dir \\\n    -family \"PolarFire\" \\\n    -die \"MPF100T\" \\\n    -package \"FCG484\" \\\n    -speed \"-1\" \\\n    -die_voltage \"1.0\"\n\nputs \"✓ Proje oluşturuldu: $project_name\"\n\n################################################################################\n## RTL DOSYALARINI EKLE\n################################################################################\n\n# VHDL dosyaları (common + polarfire modüller)\nset vhdl_files {\n    ../rtl/common/kill_protocol.vhd\n    ../rtl/common/crypto_core_stub.vhd\n    ../rtl/common/system_supervisor.vhd\n    ../rtl/polarfire/watchdog_monitor.vhd\n    ../rtl/polarfire/polarfire_clocking.vhd\n    ../rtl/polarfire/polarfire_top.vhd\n}\n\nforeach file $vhdl_files {\n    if {[file exists $file]} {\n        import_files -library work -hdl_source $file\n        puts \"  ← $file\"\n    } else {\n        puts \"HATA: Dosya bulunamad\u0131: $file\"\n        exit 1\n    }\n}\n\nputs \"✓ RTL dosyaları eklendi (6 modül)\"\n\n################################################################################\n## CONSTRAINT DOSYALARINI EKLE\n################################################################################\n\nset pdc_file \"../rtl/polarfire/polarfire_constraints.pdc\"\n\nif {[file exists $pdc_file]} {\n    import_files -io_pdc $pdc_file\n    puts \"✓ PDC constraint dosyası eklendi\"\n} else {\n    puts \"UYARI: PDC dosyası bulunamad\u0131: $pdc_file\"\n}\n\n################################################################################\n## TOP MODULE AYARLA\n################################################################################\n\nset_root -module {polarfire_top}\nputs \"✓ Top module 'polarfire_top' ayarlandı\"\n\n################################################################################\n## SENTEZ (SYNTHESIS)\n################################################################################\n\nputs \"==========================================\"\nputs \"  SENTEZ BA\u015eLATILIYOR (Synplify Pro)...\"\nputs \"==========================================\"\n\n# Sentez ayarları\nconfigure_tool -name {SYNTHESIZE} \\\n    -params {SYNPLIFY_OPTIONS:set_option -frequency 200}\n\n# Sentez çalıştır\nrun_tool -name {SYNTHESIZE}\n\nputs \"✓ Sentez tamamlandı\"\n\n################################################################################\n## PLACE & ROUTE\n################################################################################\n\nputs \"==========================================\"\nputs \"  PLACE & ROUTE BA\u015eLATILIYOR...\"\nputs \"==========================================\"\n\nrun_tool -name {PLACEROUTE}\n\nputs \"✓ Place & Route tamamland\u0131\"\n\n################################################################################\n## TİMİNG ANALİZİ\n################################################################################\n\nputs \"==========================================\"\nputs \"  T\u0130M\u0130NG RAPORLARI OLUŞTURULUYOR...\"\nputs \"==========================================\"\n\nrun_tool -name {VERIFYTIMING}\n\n# Raporlar\u0131 kaydet\nfile mkdir \"$project_dir/reports\"\n\n# Timing raporu\nreport timing -analysis max -print_paths yes \\\n    -max_paths 10 \\\n    -max_expanded_paths 1 \\\n    > \"$project_dir/reports/timing_summary.rpt\"\n\nputs \"✓ Timing Report → reports/timing_summary.rpt\"\n\n# Utilization raporu\nreport datasheet \\\n    > \"$project_dir/reports/utilization.rpt\"\n\nputs \"✓ Utilization Report → reports/utilization.rpt\"\n\n################################################################################\n## BİTSTREAM OLUŞTUR\n################################################################################\n\nputs \"==========================================\"\nputs \"  BİTSTREAM OLUŞTURULUYOR...\"\nputs \"==========================================\"\n\nrun_tool -name {GENERATEPROGRAMMINGDATA}\n\n# Bitstream dosyas\u0131n\u0131 kopyala\nif {[file exists \"$project_dir/designer/polarfire_top/polarfire_top.stp\"]} {\n    file copy -force \\\n        \"$project_dir/designer/polarfire_top/polarfire_top.stp\" \\\n        \"$project_dir/titan_v13_pf.stp\"\n    puts \"✓✓ BITSTREAM → $project_dir/titan_v13_pf.stp\"\nelse\n    puts \"UYARI: Bitstream dosyası oluşturulamadı\"\n}\n\n################################################################################\n## ÖZET RAPOR\n################################################################################\n\nputs \"=\"\nputs \"=========================================\"\nputs \"  BU\u0130LD TAMAMLANDI!\"\nputs \"=========================================\"\nputs \"\"\nputs \"Proje Dizini: $project_dir\"\nputs \"Raporlar: $project_dir/reports/\"\nputs \"\"\nputs \"Kritik Kontroller:\"\nputs \"  1. Utilization: COMB kullan\u0131m\u0131\"\nputs \"  2. Timing: WNS > 0 (setup time)\"\nputs \"  3. Watchdog: timer_cnt FF say\u0131s\u0131\"\nputs \"==========================================\"\n\nsave_project\nexit 0\n\n################################################################################\n## TASARIM NOTLARI\n################################################################################\n## 1. LIBERO vs VIVADO\n##    → Libero: Microchip PolarFire için (Synplify Pro sentez)\n##    → Vivado: Xilinx Artix-7 için\n##    → Her iki script de benzer yap\u0131da (paralel geliştirme)\n##\n## 2. SYNPLIFY PRO OPT\u0130M\u0130ZASYON\n##    → syn_keep attribute'ları kill_protocol ve crypto_core_stub'da\n##    → Bu attributes olmadan Synplify register'ları silebilir\n##\n## 3. PDC CONSTRAINT DOSYASI\n##    → polarfire_constraints.pdc: Pin atamalar\u0131 ve timing\n##    → ARTIX_HEARTBEAT ve KILL_PIN_OUT pinleri kritik\n##\n## 4. RAPORLAR\n##    → timing_summary.rpt: WNS (Worst Negative Slack)\n##    → utilization.rpt: COMB, SEQ, RAM kullan\u0131m\u0131\n##\n## 5. BITSTREAM FORMAT\n##    → .stp dosyas\u0131: PolarFire programming file\n##    → FlashPro ile yüklenir (JTAG)\n##\n## 6. BAŞARI KRİTERLERİ\n##    A) Sentez:\n##       → watchdog_monitor compile edildi\n##       → sys_keep attribute'lar\u0131 görüldü\n##    \n##    B) Timing:\n##       → WNS > 0 (50 MHz saat için)\n##       → watchdog timeout logic critical path <20ns\n##    \n##    C) Utilization:\n##       → SEQ (FF): ~400 (256 crypto + 27 watchdog + di\u011ferleri)\n##       → COMB: ~300 (kill FSM + watchdog logic)\n--------------------------------------------------------------------------------\n
